# Printwright web app settings. deploy/install.sh writes ~/.config/printwright/env
# from this file on the first run. Edit that copy, then run deploy/install.sh again.
# systemd reads it: use absolute paths, no ~ and no $HOME.

# Your workspace: parts, projects and printwright.json (required).
PRINTWRIGHT_WORKSPACE=/home/you/printwright-workspace
# Optional: Claude model for the chat, e.g. opus or sonnet. Empty = Claude Code's default.
PRINT_WEB_MODEL=
# Where the web app listens. There is no login: keep it on a trusted LAN.
PRINT_WEB_HOST=0.0.0.0
PRINT_WEB_PORT=8420
# Set to 1 to stop the app from committing chat changes in the workspace repo.
#PRINT_WEB_NO_GIT=1
